# APPLICATION
NODE_ENV=production
LEADGEN_BASE_URL=https://leadgen.example.com
LEADGEN_CLIENT_INSTANCE_ID=client-slug
LEADGEN_CLIENT_MAILBOX=client@example.com
OUTREACH_SIGNATURE=Имя, должность\nКомпания

# AUTH
AUTH_USERNAME=
# Format: scrypt$<salt>$<base64url hash>. See docs/client-vps-deploy.md.
AUTH_PASSWORD_HASH=
# Random value, at least 32 characters.
AUTH_SESSION_SECRET=
# 15..1440 minutes. A new random session id is issued after every login.
AUTH_SESSION_TTL_MINUTES=480

# SEARCH
# browser requires no paid API. Optional alternatives: auto, yandex, tavily, yandex_tavily.
LEADGEN_SEARCH_PROVIDER=browser
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_RU_REGION_ID=225
TAVILY_API_KEY=
LEADGEN_SEARCH_MAX_PAGES=5
LEADGEN_DISCOVERY_CANDIDATE_BUDGET=240
LEADGEN_CAMPAIGN_COMPANY_LIMIT=60
LEADGEN_CONTACT_READY_TARGET=20
LEADGEN_CAMPAIGN_EMAIL_TARGET=20
LEADGEN_DAILY_LEAD_LIMIT=50

# LLM (optional; current deterministic gates continue to work without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Source files are not stored; only extracted text is sent to OpenAI when the key is configured.
ICP_UPLOAD_MAX_BYTES=2000000

# SMTP — dedicated client mailbox only
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# IMAP — dedicated client mailbox only
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# STORAGE
LEADGEN_LOCAL_DATA_DIR=/var/lib/leadgen-client
LEADGEN_BACKUP_DIR=/var/backups/leadgen-client

# QUEUE
# Keep true until the client mailbox and test recipient have been verified.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=
EMAIL_DAILY_SEND_LIMIT=50
EMAIL_BATCH_SEND_LIMIT=20
EMAIL_MIN_DELAY_SECONDS=300
EMAIL_MAX_DELAY_SECONDS=600
EMAIL_BUSINESS_TIMEZONE=Europe/Moscow
OUTREACH_PROCESSOR_SECRET=

# FOLLOW-UP
FOLLOWUP_ENABLED=true
FOLLOWUP_AUTOMATION_ENABLED=false
FOLLOWUP_AUTOMATION_SCAN_MINUTES=15
FOLLOWUP_MIN_INTERVAL_HOURS=24
FOLLOWUP_MAX_PER_LEAD=1
